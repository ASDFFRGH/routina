<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the portrait within the central 66dp of the 108dp adaptive icon.
     The transparent PNG is scaled to the inset bounds for every density. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="19.4444%"
    android:insetTop="19.4444%"
    android:insetRight="19.4444%"
    android:insetBottom="19.4444%">
    <bitmap
        android:src="@drawable/routina_mascot_portrait"
        android:gravity="fill"
        android:filter="true" />
</inset>
